# Chain
NEXT_PUBLIC_CHAIN_ID=143
NEXT_PUBLIC_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://monadscan.com

# Auth (Mera passkey — rpId is forever, bound to the domain at creation)
# Leave empty in dev: falls back to window.location.hostname (localhost passkeys
# never survive to prod). Set to the exact prod domain BEFORE creating demo passkeys.
NEXT_PUBLIC_RP_ID=

# Contracts (fill after deployment)
NEXT_PUBLIC_AUSD_ADDRESS=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
NEXT_PUBLIC_ESCROW_ADDRESS=
# Optional: deployment block for efficient direct event history when Supabase is not configured.
NEXT_PUBLIC_ESCROW_DEPLOYMENT_BLOCK=

# Supabase (server-side history index only — never custodial)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role fallback; prefer a new sb_secret_ key.
SUPABASE_SERVICE_ROLE_KEY=

# DEV ONLY — local app mode without a passkey ceremony. Lives ONLY in .env.local
# (gitignored, NEVER committed). The app refuses it in production builds even if
# set. Trivial funds only.
NEXT_PUBLIC_DEV_BURNER_KEY=

# Relayer server wallet for /api/claim (0x… 64 hex). Gas MON only, never user funds.
RELAYER_KEY=
